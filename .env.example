# Vazio usa /api no mesmo domínio. No Vite, /api é encaminhado ao Worker em 127.0.0.1:8787.
# Cadastro/login do aluno exigem Worker ativo e Cloudflare D1 com as migrações aplicadas.
# Se a API publicada estiver em outro domínio, informe sua URL HTTPS aqui.
VITE_API_URL=

# Mantenha false no portfólio. Na entrega, configure true para liberar a ativação única.
VITE_COACH_ACTIVATION=false
